@startuml
skinparam shadowing false
skinparam dpi 200
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 13

skinparam actor {
    BorderColor #333333
    BackgroundColor #FFFFFF
}

skinparam usecase {
    BorderColor #333333
    BackgroundColor #FFFFFF
    ArrowColor #333333
}

left to right direction

actor "Khách Hàng" as Actor

usecase "Xem thực đơn &\nThông tin dinh dưỡng" as Main #E8F4F8
usecase "Đăng nhập" as Login

usecase "Lọc món theo 11 danh mục" as UC1
usecase "Tra cứu Calo, Protein & Xuất xứ" as UC2
usecase "Tìm kiếm món ăn theo tên" as UC3
usecase "Xem đánh giá và phản hồi" as UC4

Actor -- Main

Main ..> Login : <<include>>

Main <.. UC1 : <<extend>>
Main <.. UC2 : <<extend>>
Main <.. UC3 : <<extend>>
Main <.. UC4 : <<extend>>

@enduml