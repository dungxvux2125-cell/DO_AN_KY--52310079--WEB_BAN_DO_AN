@startuml
skinparam shadowing false
skinparam dpi 200
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 13

skinparam actor {
    BorderColor #333333
    BackgroundColor #FFFFFF
}

skinparam usecase {
    BorderColor #333333
    BackgroundColor #FFFFFF
    ArrowColor #333333
}

left to right direction

actor "Quản Trị Viên" as Actor

usecase "Duyệt bảng chấm công &\nTính lương nhân viên" as Main #E8F4F8
usecase "Đăng nhập" as Login

usecase "Đồng bộ dữ liệu chấm công từ nhân viên" as UC1
usecase "Tính lương tự động theo số ca làm" as UC2
usecase "Phê duyệt và chốt bảng lương tháng" as UC3
usecase "Xuất báo cáo bảng lương ra Excel" as UC4

Actor -- Main

Main ..> Login : <<include>>

Main ..> UC1 : <<include>>
Main ..> UC2 : <<include>>
Main ..> UC3 : <<include>>
Main ..> UC4 : <<include>>

@enduml