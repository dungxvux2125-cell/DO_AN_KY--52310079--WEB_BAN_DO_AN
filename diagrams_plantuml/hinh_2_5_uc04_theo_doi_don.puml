@startuml
skinparam shadowing false
skinparam dpi 200
skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 13

skinparam actor {
    BorderColor #333333
    BackgroundColor #FFFFFF
}

skinparam usecase {
    BorderColor #333333
    BackgroundColor #FFFFFF
    ArrowColor #333333
}

left to right direction

actor "Khách Hàng" as Actor

usecase "Tra cứu & Theo dõi\ntiến độ đơn hàng" as Main #E8F4F8
usecase "Đăng nhập" as Login

usecase "Cập nhật tiến trình Live Stepper" as UC1
usecase "Xem chi tiết thông tin đơn hàng" as UC2
usecase "Tra cứu lịch sử đơn đã mua" as UC3
usecase "Hủy đơn hàng chờ xác nhận" as UC4

Actor -- Main

Main ..> Login : <<include>>

Main ..> UC1 : <<include>>
Main <.. UC2 : <<extend>>
Main <.. UC3 : <<extend>>
Main <.. UC4 : <<extend>>

@enduml